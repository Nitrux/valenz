<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Nitrux</vendor>
  <vendor_url>https://nxos.org/</vendor_url>
  <action id="org.nx.valenz.gpu-power-lease">
    <description>Wake the selected AMD GPU for temperature monitoring</description>
    <message>Authentication is required to wake the selected AMD GPU while Control Center is open</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/valenz-gpu-power-lease</annotate>
  </action>
</policyconfig>
